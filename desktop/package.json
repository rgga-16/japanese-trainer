{
  "name": "jlpt-n4-trainer-desktop",
  "productName": "JLPT N4 Trainer",
  "version": "0.2.0",
  "private": true,
  "description": "Windows desktop wrapper (Electron) for the JLPT N4 Trainer",
  "author": "Rgee Gallega",
  "main": "main.cjs",
  "scripts": {
    "renderer": "npm --prefix .. run build:native && node scripts/copy-renderer.mjs",
    "start": "npm run renderer && electron .",
    "dist:win": "npm run renderer && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
